# Copy to .env and paste your own key. .env is gitignored and must stay that way.
#
# A free Google AI Studio key is enough: https://aistudio.google.com/apikey
# Free tier on gemini-3.6-flash is 20 requests/day and 5/minute, which is one
# study session per day. See the README before you spend them.
#
# Nothing in tests/ needs this. `uv run pytest` passes on a fresh clone with no
# key at all -- only agent.py, scripts/smoke_test.py and scripts/regression.py
# ever call a model.
GOOGLE_API_KEY=
